# Copie para .env e preencha. O .env está no .gitignore.
ANTHROPIC_API_KEY=
# Modelo usado na correlação (opcional)
CERBERUS_MODEL=claude-opus-5-5
# Token da API CertSpotter (opcional; sem ele o limite de consultas é menor)
CERTSPOTTER_API_KEY=

# Alternativa gratuita ao Claude: modelo compatível com OpenAI (--llm openai).
# Ollama local (padrão): http://localhost:11434/v1 com, por exemplo, qwen2.5:3b
CERBERUS_LLM_BASE_URL=
CERBERUS_LLM_MODEL=
# só para APIs remotas que exigem chave (o Ollama não exige)
CERBERUS_LLM_API_KEY=
